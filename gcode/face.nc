%
O08001 (FACE MILL MACRO - ZIG ZAG)
(CALL WITH: G65 P9011 I... J... Z... R... C... F... [X... Y... K... Q... W... E...])
(I #4  = LENGTH OF PART IN X)
(J #5  = WIDTH OF PART IN Y)
(Z #26 = FINAL Z DEPTH)
(R #18 = R PLANE - CLEARANCE)
(C #3  = CUTTER DIAMETER)
(F #9  = CUTTING FEEDRATE)
(X #24 = X CENTER OF PART - DEFAULTS TO 0)
(Y #25 = Y CENTER OF PART - DEFAULTS TO 0)
(K #6  = Z TOP OF STOCK - DEFAULTS TO 0)
(Q #17 = MAX Z DEPTH PER PASS - DEFAULTS TO SINGLE PASS)
(W #23 = Y STEPOVER - DEFAULTS TO 70% OF CUTTER)
(E #8  = PLUNGE FEEDRATE - DEFAULTS TO F)

(CHECK FOR REQUIRED INPUTS)
IF [#4  EQ #0] GOTO 9001
IF [#5  EQ #0] GOTO 9002
IF [#26 EQ #0] GOTO 9003
IF [#18 EQ #0] GOTO 9004
IF [#3  EQ #0] GOTO 9006
IF [#9  EQ #0] GOTO 9008

(SET DEFAULTS FOR OPTIONAL INPUTS)
IF [#24 EQ #0] THEN #24 = 0
IF [#25 EQ #0] THEN #25 = 0
IF [#6  EQ #0] THEN #6 = 0
IF [#23 EQ #0] THEN #23 = [#3 * 0.7]
IF [#8  EQ #0] THEN #8 = #9

(Y PASS CALCULATIONS)
#101 = [#5 / 2] (HALF Y LENGTH)
#102 = [#3 / 2] (CUTTER RADIUS)
#103 = [#3 * 0.1] (Y OVERHANG - 10% OF CUTTER)

#104 = -#101 + #102 - #103 (LOCAL Y START)
#105 = #101 - #102 + #103 (LOCAL Y END)

IF [#104 GE #105] GOTO 100
(MULTI Y PASSES)
#106 = [#105 - #104] (TOTAL Y DISTANCE)
#107 = FUP[#106 / #23] (NUMBER OF STEPOVERS)
#108 = [#106 / #107] (ACTUAL Y STEPOVER)
#109 = [#107 + 1] (TOTAL Y PASSES)
GOTO 110

N100 (SINGLE Y PASS)
#104 = 0
#109 = 1
#108 = 0

N110
(X TRAVEL CALCULATION)
#110 = [#4 / 2] + #102 + 0.1 (X TRAVEL FROM CENTER, 0.1 OVERHANG)

(Z PASS CALCULATIONS)
#120 = #6 (CURRENT Z START)
IF [#17 EQ #0] GOTO 140 (NO Q PROVIDED, SINGLE PASS)

#121 = [#120 - #26] (TOTAL Z DISTANCE)
IF [#121 LE 0] GOTO 9010 (START Z IS BELOW FINAL Z)

#122 = FUP[#121 / #17] (NUMBER OF Z PASSES)
#123 = [#121 / #122] (ACTUAL Z STEP)
#124 = #122 (Z PASSES TO DO)
GOTO 150

N140 (SINGLE Z PASS)
#123 = [#120 - #26]
#124 = 1

N150
(MAIN MACHINING LOOP)
G00 G90 Z#18 (ENSURE WE ARE AT CLEARANCE)

#125 = #120 (Z TRACKER)
#126 = 0 (Z PASS COUNTER)

WHILE [#126 LT #124] DO 1
  #125 = #125 - #123 (CALCULATE NEXT Z DEPTH)
  
  (SETUP Y LOOP FOR THIS Z LEVEL)
  #111 = 0 (Y PASS COUNTER)
  #113 = #104 (CURRENT Y LOCAL)
  #114 = 1 (DIRECTION: 1=LEFT TO RIGHT, -1=RIGHT TO LEFT)
  
  (POSITION FOR FIRST PASS AT THIS Z LEVEL)
  #115 = [#24 - #110] (LEFT X START)
  G00 X#115 Y[#25 + #113]
  
  (PLUNGE Z)
  G01 Z#125 F#8
  
  (Y ZIG-ZAG LOOP)
  WHILE [#111 LT #109] DO 2
    IF [#114 EQ -1] GOTO 160
    (LEFT TO RIGHT)
    #115 = [#24 - #110]
    #116 = [#24 + #110]
    GOTO 170
    N160 (RIGHT TO LEFT)
    #115 = [#24 + #110]
    #116 = [#24 - #110]
    N170
    
    (CUT ACROSS X)
    G01 X#116 F#9
    
    (UPDATE FOR NEXT Y PASS)
    #113 = #113 + #108
    #114 = -#114
    #111 = #111 + 1
    
    (IF MORE Y PASSES, FEED TO NEXT Y)
    IF [#111 GE #109] GOTO 180
    G01 Y[#25 + #113] F#9
    N180
  END 2
  
  (RETRACT Z AFTER FULL XY LAYER)
  G00 Z#18
  
  #126 = #126 + 1
END 1

GOTO 9999

(ERROR MESSAGES)
N9001 #3000=1 (MISSING I PART LENGTH)
N9002 #3000=2 (MISSING J PART WIDTH)
N9003 #3000=3 (MISSING Z DEPTH)
N9004 #3000=4 (MISSING R CLEARANCE)
N9006 #3000=6 (MISSING C CUTTER DIAMETER)
N9008 #3000=8 (MISSING F FEEDRATE)
N9010 #3000=10 (K START Z BELOW FINAL Z)

N9999
M99
%
