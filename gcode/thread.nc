%
O09010 (THREAD MILL MACRO - INTERNAL RIGHT HAND)
(CALL WITH: G65 P9010 Z... R... D... C... Q... F... [X... Y... K... E...])
(NOTE: USES CENTER-LINE PROGRAMMING. NO G41/G42 REQUIRED)
(X #24 = X CENTER OF HOLE - OPTIONAL)
(Y #25 = Y CENTER OF HOLE - OPTIONAL)
(Z #26 = Z DEPTH - BOTTOM OF THREAD)
(R #18 = R PLANE - CLEARANCE)
(D #7  = NOMINAL THREAD MAJOR DIAMETER)
(C #3  = CUTTER DIAMETER)
(Q #17 = THREAD PITCH - IN/REV OR MM/REV)
(F #9  = LINEAR FEEDRATE)
(E #8  = PLUNGE FEEDRATE - OPTIONAL, DEFAULTS TO F)
(K #6  = NUMBER OF THREADING REVOLUTIONS - DEFAULT 1)

(CHECK FOR REQUIRED INPUTS)
IF [#26 EQ #0] GOTO 9003
IF [#18 EQ #0] GOTO 9004
IF [#7  EQ #0] GOTO 9005
IF [#3  EQ #0] GOTO 9006
IF [#17 EQ #0] GOTO 9007
IF [#9  EQ #0] GOTO 9008

(SET DEFAULTS FOR OPTIONAL INPUTS)
IF [#6 EQ #0] THEN #6 = 1.0
IF [#8 EQ #0] THEN #8 = #9

(CALCULATIONS)
#101 = [#7 / 2] (HOLE RADIUS)
#102 = [#3 / 2] (CUTTER RADIUS)
#103 = [#101 - #102] (TOOL PATH CENTER RADIUS)

IF [#103 LE 0] GOTO 9009 (CUTTER DIA TOO LARGE)

#104 = [#9 * [#103 / #101]] (COMPENSATED FEEDRATE FOR INTERNAL CIRCLE)

(TOOLPATH START)
(MOVE TO X Y IF PROVIDED)
IF [#24 EQ #0] GOTO 11
G00 G90 X#24
N11
IF [#25 EQ #0] GOTO 12
G00 G90 Y#25
N12

G00 G90 Z#18 (RAPID TO CLEARANCE PLANE)
G01 Z#26 F#8 (FEED TO Z BOTTOM)

(180 DEGREE HELICAL LEAD-IN)
G91 (INCREMENTAL MODE)
G03 X0 Y#103 Z[#17 / 2] I0 J[#103 / 2] F#104

(HELICAL INTERPOLATION - MAIN CUT)
#105 = 0 (COUNTER)
WHILE [#105 LT #6] DO 1
  G03 X0 Y0 Z#17 I0 J-[#103] F#104
  #105 = #105 + 1
END 1

(180 DEGREE HELICAL LEAD-OUT)
G03 X0 Y-[#103] Z[#17 / 2] I0 J-[#103 / 2] F#104

G90 (ABSOLUTE MODE)
G00 Z#18 (RAPID TO CLEARANCE)

GOTO 9999

(ERROR MESSAGES)
N9003 #3000=3 (MISSING Z DEPTH)
N9004 #3000=4 (MISSING R CLEARANCE)
N9005 #3000=5 (MISSING D THREAD DIAMETER)
N9006 #3000=6 (MISSING C CUTTER DIAMETER)
N9007 #3000=7 (MISSING Q THREAD PITCH)
N9008 #3000=8 (MISSING F FEEDRATE)
N9009 #3000=9 (CUTTER DIA TOO LARGE)

N9999
M99
%
